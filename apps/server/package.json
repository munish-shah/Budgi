{
  "name": "@budgi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Budgi relay: holds Plaid credentials so your phone never has to.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --external:hono --external:@hono/node-server --external:zod --external:qrcode-terminal --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "pair": "tsx --env-file-if-exists=.env src/cli.ts pair",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:cloud": "wrangler dev --local --port 8788"
  },
  "dependencies": {
    "@budgi/core": "*",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
