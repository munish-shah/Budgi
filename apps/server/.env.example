# Copy to .env and fill in. Never commit .env.

# Plaid keys from https://dashboard.plaid.com/developers/keys
# For personal use, sign up with "Personal use" to get the free Trial plan.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
# Needed for OAuth banks (Chase, etc.) on iOS — a universal link you control.
# PLAID_REDIRECT_URI=https://budgi.example.com/plaid-oauth

# 32 random bytes, base64. Generate: npm run cli -w @budgi/server keygen
# Encrypts Plaid access tokens at rest. Losing it means re-linking banks.
BUDGI_MASTER_KEY=

# How your phone reaches this server. Prefer a Tailscale HTTPS name, e.g.
# https://budgi-relay.your-tailnet.ts.net
PUBLIC_URL=http://127.0.0.1:8787
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./budgi.db
# Set to 1 only when behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
